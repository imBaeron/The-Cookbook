# Copy this file to a new file named ".env" and fill in the values.
# ".env" is ignored by Git, so your real key never gets committed.
# After changing .env, fully stop and restart `npx expo start`.

# Your Spoonacular API key (spoonacular.com/food-api -> profile/dashboard).
# Used when the app talks to Spoonacular directly.
EXPO_PUBLIC_SPOONACULAR_API_KEY=your_key_here

# OPTIONAL: address of your own proxy server (we'll add this later).
# When this is set, the app sends requests there instead and the API key
# above is not used. Leave it empty for now.
EXPO_PUBLIC_API_BASE_URL=

# OPTIONAL: set to true to use the built-in sample recipes (no internet,
# no API points used). Handy for demos and for working on the design.
EXPO_PUBLIC_USE_MOCK_DATA=false
